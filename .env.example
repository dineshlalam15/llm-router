# ==========================================
# LLM PROVIDER API KEYS
# ==========================================
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
LITELLM_API_KEY=

# ==========================================
# ML ROUTER CONFIGURATION
# ==========================================
# Minimum confidence (0.0 to 1.0) required to trust the primary SVM model's prediction[cite: 1].
# If the model's confidence is below this, it triggers the KNN fallback[cite: 1].
CONFIDENCE_THRESHOLD=0.65

# The provider to use if all ML models fail the confidence check[cite: 1].
FALLBACK_PROVIDER=litellm

# ==========================================
# ML MODEL FILE PATHS
# ==========================================
# Optional: Override these if deploying to a server with a custom model directory[cite: 1].
# MODEL_DIR=models_out/