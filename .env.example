# LLM PROVIDER API KEYS
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# If using a self-hosted LiteLLM Proxy, provide the master key or gateway URL. 
# If just using the LiteLLM SDK, this might not be needed.
LITELLM_API_KEY=


# Minimum confidence (0.0 to 1.0) required to trust the ML model's prediction.
# If the model's confidence is below this, it triggers the fallback provider.
CONFIDENCE_THRESHOLD=0.60

# The provider to use if the model's confidence is below the threshold.
# Valid options: openai, claude, gemini, litellm
FALLBACK_PROVIDER=litellm


# Optional: Override these only if you are deploying to a server and storing 
# the .joblib files in a custom directory (e.g., /opt/ml_models/...)
# For local development, leave these commented out to use the defaults.
# MODEL_PATH=model/router_model.joblib
# VECTORIZER_PATH=model/vectorizer.joblib