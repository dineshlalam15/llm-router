# ML ROUTER CONFIGURATION

# Minimum confidence (0.0 to 1.0) required to trust the primary SVM model's prediction.
# If the model's confidence is below this, it triggers the KNN fallback.
CONFIDENCE_THRESHOLD=

# The default model and provider to use if all ML models fail the confidence check.
DEFAULT_PROVIDER=
DEFAULT_MODEL=

# ==========================================
# ML MODEL FILE PATHS
# ==========================================
# Optional: Override these if deploying to a server with a custom model directory[cite: 1].
# MODEL_DIR=models_out/